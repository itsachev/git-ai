{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-ai",
  "mainBinaryName": "gitai",
  "version": "0.1.1",
  "identifier": "dev.gitai.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "git-ai",
        "width": 1280,
        "minWidth": 360,
        "height": 800,
        "minHeight": 500,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwNTFFOTNFNTQzNDcxRTcKUldUbmNUUlVQdWxSMEJSNWVQSk55YnNhQ0pFejFSNTRuc3JyNVRIMmU4Y2F0RHplRDJNczNJMkoK",
      "endpoints": [
        "https://github.com/itsachev/git-ai/releases/latest/download/latest.json"
      ]
    }
  }
}
